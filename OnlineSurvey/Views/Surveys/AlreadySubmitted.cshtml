@model Survey
@{
    ViewData["Title"] = "Đã gửi khảo sát";
}

<div class="result-state">
    <div class="result-icon result-icon-info">i</div>
    <span class="eyebrow">Khảo sát đã được ghi nhận</span>
    <h1 class="display-6 fw-bold">Bạn đã đạt giới hạn 3 lần gửi</h1>
    <p class="lead text-secondary">Bạn đã hoàn thành khảo sát “@Model.Title” đủ 3 lần. Hệ thống tạm khóa lượt gửi tiếp theo trong 10 phút.</p>
    <a class="btn btn-outline-primary" asp-controller="Home" asp-action="Index">Về trang chủ</a>
</div>
